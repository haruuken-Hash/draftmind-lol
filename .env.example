# Copia este archivo como .env y rellena los valores. .env nunca se sube a Git.

# Clave de desarrollo de Riot (https://developer.riotgames.com/).
# Opcional: sin ella la aplicación funciona en modo demostración.
RIOT_API_KEY=

# Carpeta para la base de datos y la caché. Si se deja vacía se usa
# %LOCALAPPDATA%\DraftMindLoL
DRAFTMIND_DATA_DIR=

# Idioma de los datos de Data Dragon (es_MX, es_ES, en_US...).
DRAFTMIND_LANGUAGE=es_MX

# Nivel de registro: DEBUG, INFO, WARNING, ERROR
DRAFTMIND_LOG_LEVEL=INFO
